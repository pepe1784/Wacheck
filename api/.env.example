# ====================================
# CONFIGURACIÓN DE ENTORNO - WACHECK API
# ====================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Rellena los valores con tus credenciales reales
# 3. NUNCA subas el archivo .env a GitHub o repositorios públicos
# ====================================

# Entorno (development, production)
APP_ENV=production
APP_DEBUG=false

# URL de la aplicación (sin / al final)
APP_URL=https://tu-subdominio.infinityfreeapp.com

# Base de datos (InfinityFree proporciona estos datos en el panel)
DB_HOST=sql123.infinityfree.com
DB_NAME=if0_12345678_wacheck
DB_USER=if0_12345678
DB_PASS=tu_password_aqui

# Seguridad
# Genera esto con: bin2hex(random_bytes(32))
APP_SECRET_KEY=cambia_esto_por_una_clave_secreta_de_64_caracteres_hexadecimales

# Encriptación (AES-256)
# Genera esto con: openssl rand -base64 32
ENCRYPTION_KEY=cambia_esto_por_una_clave_de_32_bytes_base64

# JWT (JSON Web Tokens)
JWT_SECRET=cambia_esto_por_un_secret_jwt_seguro
JWT_EXPIRATION=86400

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# CORS (tu dominio de InfinityFree)
CORS_ALLOWED_ORIGINS=https://tu-subdominio.infinityfreeapp.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Session
SESSION_LIFETIME=7200
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# Logging (dejar vacío para usar log del sistema en shared hosting)
LOG_LEVEL=error
LOG_FILE=

# Google OAuth 2.0 (Configurar en https://console.cloud.google.com)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REDIRECT_URI=https://tu-subdominio.infinityfreeapp.com/api/oauth_google.php

# SMTP (InfinityFree usa mail() nativo, estas vars son opcionales)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicacion-aqui
SMTP_FROM_EMAIL=tu-correo@gmail.com
SMTP_FROM_NAME=Wacheck

# Panel de administración
ADMIN_EMAIL=tu-admin@gmail.com
ADMIN_PASSWORD_HASH=$2y$12$hash_generado_con_password_hash
ADMIN_API_TOKEN=token_seguro_generado_con_bin2hex_random_bytes_32
